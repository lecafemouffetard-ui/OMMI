# ============================================
# OMMI - Variables d'environnement
# ============================================

# Port du serveur
PORT=3000

# URL du frontend
FRONTEND_URL=https://ommi.vercel.app

# ============================================
# SUPABASE (Base de données)
# ============================================
# 1. Créer un compte sur https://supabase.com (gratuit)
# 2. Créer un nouveau projet
# 3. Copier les clés depuis Settings > API

SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=votre-clé-anon-publique

# ============================================
# STRIPE (Paiements)
# ============================================
# 1. Créer compte sur https://stripe.com
# 2. Récupérer clés dans Dashboard > Developers > API keys

STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx

# ============================================
# APIs IA - IMAGE TO VIDEO
# ============================================

# HAIPER AI (Gratuit pour commencer)
# https://haiper.ai
HAIPER_API_KEY=votre-clé-haiper

# KLING AI (Payant ~0.10€/vidéo - Qualité TOP)
# https://klingai.com
KLING_API_KEY=votre-clé-kling

# LUMA AI (Payant ~0.08€/vidéo - Excellent)
# https://lumalabs.ai
LUMA_API_KEY=votre-clé-luma

# ============================================
# APIs IA - HOME STAGING
# ============================================

# REPLICATE (5$ crédits gratuits)
# https://replicate.com
REPLICATE_API_KEY=r8_xxxxxx

# ============================================
# STOCKAGE FICHIERS
# ============================================

# Cloudflare R2 (Alternative gratuite à AWS S3)
CLOUDFLARE_ACCOUNT_ID=votre-account-id
CLOUDFLARE_ACCESS_KEY_ID=votre-access-key
CLOUDFLARE_SECRET_ACCESS_KEY=votre-secret-key

# ============================================
# NOTES D'INSTALLATION
# ============================================

# ÉTAPE 1 : Copier ce fichier en .env
# cp .env.example .env

# ÉTAPE 2 : Installer les dépendances
# npm install

# ÉTAPE 3 : Configurer Supabase
# - Créer les tables (voir supabase-schema.sql)
# - Activer Storage bucket "uploads"

# ÉTAPE 4 : Configurer Stripe
# - Créer produits et prix
# - Configurer webhook

# ÉTAPE 5 : Choisir API IA
# - Haiper (gratuit) pour tester
# - Kling ou Luma pour production

# ÉTAPE 6 : Démarrer le serveur
# npm run dev